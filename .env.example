MORI_PUBLIC_URL=https://media.laplacian.net
MORI_BIND_ADDRESS=127.0.0.1
MORI_PORT=3000
MORI_NETWORK=mori
MORI_IMAGE=mori:local
MORI_ADMIN_USERNAME=root
MORI_ADMIN_PASSWORD=replace-with-a-long-random-password
MORI_MAX_UPLOAD_BYTES=1000000000
MORI_MAX_IMAGE_UPLOAD_BYTES=104857600
MORI_VIDEO_EXTENSIONS=mp4,m4v,mov,webm,mkv,avi,ogv,mpeg,mpg,ts,mts,m2ts,3gp,wmv,flv
MORI_IMAGE_EXTENSIONS=jpg,jpeg,png,apng,gif,webp,avif,bmp,ico,tif,tiff,heic,heif,jxl,svg,dng,cr2,cr3,nef,arw,raf,rw2,orf,pef,psd
